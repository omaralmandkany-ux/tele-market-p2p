{
    "name": "tele-market-functions",
    "version": "1.0.0",
    "description": "Cloud Functions for Telegram Ad Marketplace",
    "main": "lib/index.js",
    "scripts": {
        "build": "tsc",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": "18"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "express": "^4.18.2",
        "firebase-admin": "^11.11.0",
        "firebase-functions": "^4.5.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.15",
        "@types/express": "^4.17.21",
        "typescript": "^5.3.2"
    },
    "private": true
}