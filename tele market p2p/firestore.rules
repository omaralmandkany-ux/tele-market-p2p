rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // SECURITY: clients never use Firestore directly - the API (Cloud Functions,
    // Admin SDK) does all reads/writes and is not affected by these rules.
    // The previous rules let any signed-in Firebase user edit their own balance,
    // read/write every deal, wallet and transaction. Deny all direct access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
